# ==============================================================================
# SafeWaste environment variables. Copy to .env.local and fill in real values.
# Validated at startup by src/lib/env-schema.ts: secrets have NO defaults, and
# placeholder values are refused. Never commit or share .env.local.
# ==============================================================================

# --- Neon PostgreSQL ----------------------------------------------------------
# Pooled connection (host contains "-pooler") for the app.
DATABASE_URL=
# Direct connection (same host without "-pooler") for migrations.
DATABASE_URL_UNPOOLED=

# --- Clerk (identity only) ----------------------------------------------------
# Dashboard -> Configure -> API keys. pk_test_/sk_test_ in development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard -> Webhooks (needed from Gate 1b.8). Starts with whsec_.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- App ----------------------------------------------------------------------
# Bearer secret for POST /api/jobs/* (at least 32 characters, random).
CRON_SECRET=
# Encrypts pickup OTP codes while they wait in the outbox: 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OUTBOX_ENCRYPTION_KEY=
# "0" stops the immediate outbox send after a commit (development / tests only; refused in production).
OUTBOX_DISPATCH_AFTER_COMMIT=
# Base URL for links in emails and verification QR codes. Required in production;
# defaults to http://localhost:3000 in development.
APP_BASE_URL=
# Folder for certificate PDFs (development storage adapter; default .storage). Production storage: Gate 7.4.
STORAGE_DIR=

# --- Map tiles (OpenStreetMap public tiles are for the demo only) --------------
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
