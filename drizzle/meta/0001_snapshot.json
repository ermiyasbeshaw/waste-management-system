          "value": "(\"users\".\"role\" IN ('hospital_admin', 'hospital_staff', 'disposal_operator') AND \"users\".\"facility_id\" IS NOT NULL)\n       OR (\"users\".\"role\" IN ('super_admin', 'driver', 'efda_officer') AND \"users\".\"facility_id\" IS NULL)\n       OR (\"users\".\"role\" IS NULL AND \"users\".\"facility_id\" IS NULL)"
